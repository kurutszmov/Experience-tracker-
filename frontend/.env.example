# URL бэкенда (обязательно с /api на конце).
# Для веба локально: http://localhost:5000/api
# Для мобильного приложения нужен адрес, доступный с телефона:
#   - эмулятор Android:       http://10.0.2.2:5000/api
#   - телефон в той же Wi-Fi:  http://192.168.x.x:5000/api
#   - продакшн (рекомендуется): https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
